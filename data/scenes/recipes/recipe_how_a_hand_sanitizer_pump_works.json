  "facts": {
    "intro": "The clear container holds the gel, visible through the transparent walls.",
    "reveal": "When you press the top, the head moves down, compressing the spring.",
    "step1": "The stem attached to the head slides down, pushing the gel upward.",
    "step2": "The gel is forced through the narrow spout, forming a small bead on the tip.",
    "step3": "Releasing the head lets the spring expand, pulling the stem back to its original position.",
    "step4": "The spring\u2019s pull refills the chamber beneath the head with more gel, ready for the next press.",
    "hold": "You can feel the resistance of the spring as you hold the head down, indicating the pump is loading.",
    "payoff": "A fresh dose of sanitizer is dispensed, and the mechanism resets automatically for the next use."
  }
